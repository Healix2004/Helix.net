                    sh "docker push ${DOCKER_HUB_IMAGE}:v${BUILD_NUMBER}"
                    sh "docker push ${DOCKER_HUB_IMAGE}:latest"
                    
                    sh "docker logout" 
                }
            }
        }

        stage('CleanUp Local Image') {
            steps {
                echo "Cleaning up local images..."
                sh "docker rmi ${DOCKER_HUB_IMAGE}:v${BUILD_NUMBER} || true"
                sh "docker rmi ${DOCKER_HUB_IMAGE}:latest || true"
                sh "docker image prune -f"
            }
        }

        stage('Deploy Backend to AWS') {
            steps {
                echo "Deploying Backend to AWS EC2..."
                sshagent(credentials: ["${EC2_CREDS_ID}"]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} '
                            cd my-web-app &&
