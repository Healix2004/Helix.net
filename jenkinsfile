pipeline {
    agent any
/*
    environment {
      
        DOCKER_HUB_IMAGE = 'mostafasaad21/helix-backend'
        DOCKER_HUB_CREDS = 'docker-hub-creds' 
        
        
        EC2_IP = '100.53.238.193' 
        EC2_USER = 'ec2-user' 
        EC2_CREDS_ID = 'aws-ec2-key' 
    }
*/
environment {
        AWS_REGISTRY_ID = '123456789012' 
        AWS_REGION      = 'us-east-1'     
        CLUSTER_NAME    = 'helix-eks-cluster'
        REPO_NAME       = 'helix-backend'
        IMAGE_TAG       = "${BUILD_NUMBER}"
        ECR_URL         = "${AWS_REGISTRY_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }


    stages {
        stage('Initialize & Clean') {
            steps {
                echo "Cleaning Workspace for HelixBackend..."
                cleanWs() 
            }
        }

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }
/*

        stage('Build Backend Image') {
            steps {
                echo "Building Docker Image for Backend..."
                sh "docker build -t ${DOCKER_HUB_IMAGE}:v${BUILD_NUMBER} -t ${DOCKER_HUB_IMAGE}:latest -f HelixAPI/Dockerfile ."
            }
        }

        stage('Push to Registry') {
            steps {
                echo "Pushing Backend Image to Docker Hub..."
                withCredentials([usernamePassword(credentialsId: "${DOCKER_HUB_CREDS}", passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
