                        '
                    """
                }
            }
        }
    }
*/
stage('AWS ECR Login') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials-id']]) {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URL}"
                }
            }
        }

        stage('Docker Build & Scan') {
            steps {
               script {
         sh "docker build -t ${ECR_URL}/${REPO_NAME}:${IMAGE_TAG} -t ${ECR_URL}/${REPO_NAME}:latest -f HelixAPI/Dockerfile ."
         sh "trivy image --exit-code 0 --severity CRITICAL ${ECR_URL}/${REPO_NAME}:${IMAGE_TAG}"            }
                  }
                      }
        stage('Docker Push to ECR') {
            steps {
                sh "docker push ${ECR_URL}/${REPO_NAME}:${IMAGE_TAG}"
                sh "docker push ${ECR_URL}/${REPO_NAME}:latest"
            }
        }

        stage('Deploy to AWS EKS') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials-id']]) {
                    script {
                        sh "aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}"
                        sh "sed -i 's|TAG_PLACEHOLDER|${IMAGE_TAG}|g' k8s/eks.yaml"
                        sh "kubectl apply -f k8s/eks.yaml"
                        sh "kubectl rollout status deployment/helix-backend-deployment"
                    }
                }
            }
        }
    }
    
    post {
        always {
            sh "docker rmi \$(docker images '${ECR_URL}/${REPO_NAME}' -q) --force || true"
        }
    }
}
    
